NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:4200

HOST_DB=localhost
PORT_DB=5432
USER_DB=transci
PASSWORD_DB=transci
DATABASE_DB=transci_ci
DB_SSL=false
DB_SYNCHRONIZE=false
DB_LOGGING=true

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting (secondes / requetes)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Invitation / activation de compte
# URL du frontend (utilisee pour construire le lien d'activation)
FRONTEND_URL=http://localhost:4200
# Duree de validite d'une invitation (heures)
USER_INVITATION_EXPIRES_IN_HOURS=24
# Cooldown entre deux renvois d'invitation (secondes)
USER_INVITATION_RESEND_COOLDOWN_SECONDS=60

# Email (SMTP) - si MAIL_HOST / MAIL_USER absents, l'envoi est simule en console
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=TransCI <no-reply@transci-ci.com>
MAIL_SEND_ENABLED=true

# Supabase Storage
# URL du projet Supabase (https://<project>.supabase.co)
SUPABASE_URL=
# Cle de service role (cote serveur uniquement, JAMAIS exposee au frontend)
SUPABASE_SERVICE_ROLE_KEY=
# Buckets (ils doivent exister dans Supabase Storage)
SUPABASE_STORAGE_BUCKET=photos
SUPABASE_BUCKET_AVATARS=avatars
SUPABASE_BUCKET_DOCUMENTS=documents
# Taille max d'un fichier televerse en octets (10 Mo)
MAX_FILE_SIZE=10485760
